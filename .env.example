# Copy to .env and adjust. Never commit .env.
POSTGRES_USER=lms
POSTGRES_PASSWORD=lms_dev_password
POSTGRES_DB=lms

LMS_DATABASE_URL=postgresql+psycopg://lms:lms_dev_password@localhost:5433/lms
LMS_TEST_DATABASE_URL=postgresql+psycopg://lms:lms_dev_password@localhost:5433/lms_test

# Generate your own: python -c "import secrets; print(secrets.token_hex(32))"
LMS_JWT_SECRET=change-me-to-a-long-random-string
LMS_JWT_EXPIRE_MINUTES=480

LMS_LOAN_DAYS=14
LMS_FINE_PER_DAY=5
LMS_MAX_ACTIVE_LOANS=3

LMS_CORS_ORIGINS=http://localhost:5173

# Auth cookie (httpOnly). MUST be true when served over HTTPS (any deploy); false only for http://localhost.
LMS_COOKIE_SECURE=false
# Login throttling: failed logins allowed per IP+email / per IP within the window (seconds), then 429.
LMS_LOGIN_MAX_FAILURES=5
LMS_LOGIN_MAX_FAILURES_PER_IP=20
LMS_LOGIN_WINDOW_SECONDS=900

# AI assistant
#   none       -> keyword search + templated answers, no network, no key needed
#   openrouter -> RAG: embeddings + an LLM, both through OpenRouter with ONE key (https://openrouter.ai/keys)
LMS_AI_PROVIDER=none
LMS_OPENROUTER_API_KEY=
# The LLM that writes answers (paid per use; Haiku is the cheapest Claude). Any OpenRouter chat model id works.
LMS_OPENROUTER_MODEL=anthropic/claude-haiku-4.5
# Embedding model (free tier). If you change it, re-run: python -m scripts.embed_books
LMS_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
