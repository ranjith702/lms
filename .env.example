# Copy to .env and adjust. Never commit .env.
POSTGRES_USER=lms
POSTGRES_PASSWORD=lms_dev_password
POSTGRES_DB=lms

LMS_DATABASE_URL=postgresql+psycopg://lms:lms_dev_password@localhost:5433/lms
LMS_TEST_DATABASE_URL=postgresql+psycopg://lms:lms_dev_password@localhost:5433/lms_test

# Generate your own: python -c "import secrets; print(secrets.token_hex(32))"
LMS_JWT_SECRET=change-me-to-a-long-random-string
LMS_JWT_EXPIRE_MINUTES=480

LMS_LOAN_DAYS=14
LMS_FINE_PER_DAY=5
LMS_MAX_ACTIVE_LOANS=3

LMS_CORS_ORIGINS=http://localhost:5173

# AI assistant: "none" for now. Later: "openrouter" + OPENROUTER_API_KEY + OPENROUTER_MODEL
LMS_AI_PROVIDER=none
LMS_OPENROUTER_API_KEY=
LMS_OPENROUTER_MODEL=
